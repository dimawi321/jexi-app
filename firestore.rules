rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default: deny all unspecified paths
    match /{document=**} {
      allow read, write: if false;
    }

    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidAccountData(data, userId) {
      return (data.accountId == null || data.accountId == userId)
        && (data.userEmail == null || (data.userEmail is string && data.userEmail.size() <= 256))
        && (data.recipients == null || (data.recipients is list && data.recipients.size() <= 1000))
        && (data.intentions == null || (data.intentions is list && data.intentions.size() <= 1000))
        && (data.history == null || (data.history is list && data.history.size() <= 10000));
    }

    // Isolated per-user JEXI account document
    // Document ID must match authenticated user's UID
    match /users/{userId} {
      // 1. Unauthenticated users cannot read or write
      // 2. Authenticated users can read ONLY their own /users/{uid} document
      allow get: if isOwner(userId);

      // Listing all user documents in /users is strictly forbidden
      allow list: if false;

      // 3. Authenticated users can create ONLY their own /users/{uid} document
      allow create: if isOwner(userId)
        && isValidAccountData(request.resource.data, userId);

      // 4. Authenticated users can update ONLY their own /users/{uid} document
      // 5. Authenticated users cannot update another user's document
      // Invariant: accountId cannot be changed to another user
      allow update: if isOwner(userId)
        && isValidAccountData(request.resource.data, userId)
        && (resource.data.accountId == null || request.resource.data.accountId == resource.data.accountId);

      // Deletions are strictly disallowed to prevent accidental data destruction
      allow delete: if false;
    }
  }
}

